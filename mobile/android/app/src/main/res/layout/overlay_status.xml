<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/overlay_root"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_overlay"
    android:elevation="8dp"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- Header / Service & Nomor -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_overlay_service"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#202A26"
            android:paddingHorizontal="6dp"
            android:paddingVertical="2dp"
            android:text="WA"
            android:textColor="@color/primary_emerald"
            android:textSize="11sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_overlay_phone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="08..."
            android:textColor="@color/text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Baris OTP (Tampil jika sudah masuk) -->
    <LinearLayout
        android:id="@+id/layout_overlay_otp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OTP: "
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tv_overlay_otp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:letterSpacing="0.1"
            android:text="------"
            android:textColor="@color/primary_emerald_light"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Status Text & Tombol Aksi -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_overlay_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Menunggu..."
            android:textColor="@color/text_secondary"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_overlay_copy"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="6dp"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="0dp"
            android:text="Salin"
            android:textColor="@color/primary_emerald"
            android:textSize="11sp" />

        <Button
            android:id="@+id/btn_overlay_finish"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:layout_marginStart="4dp"
            android:minWidth="0dp"
            android:paddingHorizontal="6dp"
            android:paddingVertical="0dp"
            android:text="Selesai"
            android:textColor="@color/color_success"
            android:textSize="11sp" />

        <ImageButton
            android:id="@+id/btn_overlay_close"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_marginStart="4dp"
            android:background="?selectableItemBackgroundBorderless"
            android:contentDescription="Tutup"
            android:src="@android:drawable/ic_menu_close_clear_cancel" />
    </LinearLayout>

</LinearLayout>

