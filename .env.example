# Salin ke environment proses (PM2 / sistem), aplikasi tidak membaca file .env sendiri.
SCPOOL_DATA_DIR=./data
SCPOOL_LOCAL_HARDWARE=0          # 1 = buka COM port di mesin ini (default: hanya di Windows)
SCPOOL_LOCAL_POOL_ID=foxcom_32
SCPOOL_LOCAL_AUTOLOGIN=0         # 1 = localhost tanpa login. Matikan di server publik
SCPOOL_ADMIN_PASSWORD=           # kosong = acak, ditulis ke data/initial_admin_password.txt
SCPOOL_PUBLIC_DOMAIN=https://scpool.example.com
SCPOOL_CORS_ORIGINS=
SCPOOL_TRUSTED_PROXIES=127.0.0.1
SCPOOL_SESSION_DAYS=7
SCPOOL_SCAN_INTERVAL=30
SCPOOL_SMS_POLL_INTERVAL=15
SCPOOL_TELEGRAM_BOT_TOKEN=
SCPOOL_TELEGRAM_CHAT_ID=
SCPOOL_LOG_LEVEL=INFO
